	"narration_act2_scene5_hf_6": {
		"type": "dialogue",
		"speaker": "",
		"text": "A portal opens, and the Narrator storms through from the top floor.",
		"next": "narrator_act2_scene5_hf_1"
	},
	
	"narrator_act2_scene5_hf_1": {
		"type": "dialogue",
		"speaker": "The Narrator",
		"text": "What have you DONE!? You've ruined everything! All my hard work trying to guide you to the right choice, and you threw it away!",
		"next": "narration_act2_scene5_hf_7"
	},
	
	"narration_act2_scene5_hf_7": {
		"type": "dialogue",
		"speaker": "",
		"text": "Zach, Kyle, and Jayce run through the portal to the top floor and find a dragon in chains, its jaws held shut by a muzzle made of ice.",
		"next": "narration_act2_scene5_hf_8"
	},
	
	"narration_act2_scene5_hf_8": {
		"type": "dialogue",
		"speaker": "",
		"text": "Zach reaches out and pets the dragon. It smiles at him.",
		"next": "narration_act2_scene5_hf_9"
	},
	
	"narration_act2_scene5_hf_9": {
		"type": "dialogue",
		"speaker": "",
		"text": "The Narrator comes through the portal behind them.",
		"next": "zach_act2_scene5_hf_7"
	},
	
	"zach_act2_scene5_hf_7": {
		"type": "dialogue",
		"speaker": "Zach",
		"text": "We can't control everything. We can't stop every bad thing from happening. But we can still control how we live our lives.",
		"next": "narration_act2_scene5_hf_10"
	},
	
	"narration_act2_scene5_hf_10": {
		"type": "dialogue",
		"speaker": "",
		"text": "Zach uses his fire to melt the chains and break the muzzle.",
		"next": "narration_act2_scene5_hf_11"
	},
	
	"narration_act2_scene5_hf_11": {
		"type": "dialogue",
		"speaker": "",
		"text": "Zach, Kyle, and Jayce climb onto the dragon's back. It charges through the office, crashes through the large window behind the desk, and flies off toward the sunset.",
		"next": "act2_scene5_hf_choice"
	},
	
	"act2_scene5_hf_choice": {
		"type": "choice",
		"choices": [
			{
				"text": "Free the Dragon",
				"next": "end_act2"
			}
		]
	},
	
